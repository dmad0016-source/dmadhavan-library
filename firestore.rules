rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Test mode for the labs: anyone can read and write until the date below.
    // Change the date if you still need access after it, and tighten these
    // rules before storing any real data.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
