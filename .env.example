# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git, so your keys are never pushed to GitHub.
# Restart `npm run dev` after changing it.

# Firebase console > Project settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=

# Firebase console > Functions > countBooks > Request URL
# (available after `firebase deploy --only functions`)
VITE_COUNT_BOOKS_URL=
